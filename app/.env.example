# Copiá este archivo a .env.local (no se sube al repositorio) y completá con los datos de tu proyecto de Supabase.
# Son valores PÚBLICOS por diseño (van dentro del front): la URL del proyecto y la clave "publishable" (antes "anon").
# NUNCA pongas acá la clave "secret"/"service_role", ni la cadena de conexión de la base, ni el JWT secret.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
